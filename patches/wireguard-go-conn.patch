+// ensureConnected issues a connect() on the bind's UDP socket toward the
+// given destination, once per destination change. Some sandboxed egress
+// environments silently refuse (EPERM) any sendto/sendmmsg that carries a
+// per-packet destination on an unconnected UDP socket, while connected
+// sockets go through the normal per-destination approval flow and work.
+// WireGuard clients normally talk to a single endpoint, so pinning the
+// socket with connect() is behavior-preserving for that use case.
+func (s *StdNetBind) ensureConnected(conn *net.UDPConn, dst netip.AddrPort, is6 bool) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if is6 {
+		if s.connected6 == dst {
+			return nil
+		}
+	} else if s.connected4 == dst {
+		return nil
 	}
+	rc, err := conn.SyscallConn()
+	if err != nil {
+		return err
+	}
+	var sa unix.Sockaddr
+	if is6 {
+		a := dst.Addr().As16()
+		sa = &unix.SockaddrInet6{Port: int(dst.Port()), Addr: a}
+	} else {
+		a := dst.Addr().As4()
+		sa = &unix.SockaddrInet4{Port: int(dst.Port()), Addr: a}
+	}
+	var cerr error
+	err = rc.Control(func(fd uintptr) {
+		cerr = unix.Connect(int(fd), sa)
+		// Re-connecting an already connected UDP socket to the same or a
+		// new peer is legal; EISCONN just means we were already there.
+		if cerr == syscall.EISCONN {
+			cerr = nil
+		}
+	})
+	if err != nil {
+		return err
+	}
+	if cerr != nil {
+		return cerr
+	}
+	if is6 {
+		s.connected6 = dst
+	} else {
+		s.connected4 = dst
+	}
+	return nil
+}
+
+func NewStdNetBind() Bind {
+	// PATCH (soracom-honeypot): in this sandbox the stock listen-socket
+	// bind cannot hold a UDP session (see bind_rotate.go); use the
+	// rotating one-shot-socket bind instead.
+	return NewRotateBind()
 }
 
